# WARNING: These are example credentials - replace with your actual values
# SECURITY: Never commit real credentials to version control!

# Google OAuth Configuration
GOOGLE_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database Configuration  
MONGODB_URI=your-mongodb-uri

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Instructions:
# 1. Copy this file to .env.local for local development
# 2. Replace placeholder values with your actual credentials
# 3. Ensure .env.local is in your .gitignore file
# 4. Use environment-specific configurations for production