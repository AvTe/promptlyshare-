# Google OAuth Configuration
GOOGLE_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database Configuration
MONGODB_URI=your-mongodb-uri

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Security Note: 
# 1. Replace with your actual credentials before deploying
# 2. Never commit real credentials to version control
# 3. Use strong, randomly generated secrets
# 4. Consider using environment-specific configuration for production